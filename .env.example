# Copy this file to .env in the project root and fill in your own API key.
# .env is plaintext and must never be committed or shared.
DEEPSEEK_API_KEY=

# Use a model available to your DeepSeek account.
DEEPSEEK_MODEL=deepseek-flash

# Optional: configure both fields to enable OpenAI in the web model selector.
# API access is separate from a ChatGPT subscription. Choose a model that supports
# Chat Completions, developer messages, and function tools for your API account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Jev evaluation only. After the live plan and annotation checks pass,
# the CLI reads only the selected provider's API key from this fixed project file.
# Process environment values take precedence, including empty values.
# Offline and --plan-only never read this file. PYTHON_DOTENV_DISABLED opts out.
TYPESAFE_API_KEY=
